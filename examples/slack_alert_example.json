  "testing": {
    "description": "Slack 알림 테스트 방법",
    "curl_example": {
      "command": "curl -X POST YOUR_SLACK_WEBHOOK_URL -H 'Content-Type: application/json' -d @slack_test_message.json",
      "test_message": {
        "text": "🧪 *테스트 알림*",
        "attachments": [
          {
            "color": "#0000FF",
            "fields": [
              {
                "title": "Test",
                "value": "Slack 알림이 정상 작동합니다!",
                "short": false
              },
              {
                "title": "Timestamp",
                "value": "2026-01-27T12:00:00",
                "short": true
              }
            ]
          }
        ]
      }
    },
    "databricks_test": {
      "description": "Databricks 노트북에서 테스트",
      "code": "import requests\n\nwebhook_url = dbutils.secrets.get('pipeline-cred-baikalx', 'slack_webhook_url')\n\ntest_message = {\n    'text': '🧪 테스트 알림',\n    'attachments': [{\n        'color': '#0000FF',\n        'fields': [{\n            'title': 'Test',\n            'value': 'Slack 알림이 정상 작동합니다!',\n            'short': False\n        }]\n    }]\n}\n\nresponse = requests.post(webhook_url, json=test_message)\nprint(f'Status: {response.status_code}')\nprint(f'Response: {response.text}')"
    }
  },
  "customization": {
    "description": "알림 메시지 커스터마이징",
    "tips": [
      "emoji_map과 color_map을 수정하여 알림 스타일 변경",
      "fields 배열에 원하는 정보 추가",
      "attachments에 actions 추가하여 인터랙티브 버튼 생성",
      "Slack Block Kit을 사용하여 더 풍부한 UI 구성"
    ],
    "slack_block_kit_url": "https://api.slack.com/block-kit",
